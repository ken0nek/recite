# Drives `bind alt-enter __recite_submit` on a real pty. Run through binding.sh,
# which is where the opt-in gate and the reasoning for it live.
#
# Two traps, either of which makes this file report ok against the broken code
# it exists to catch:
#
# - Setup sourced from a generated rc, never typed at the prompt. A typed
#   `abbr -a zzq 'echo ABBR_EXPANDED'` leaves case A's own needle in the
#   transcript, and the case then passes without anything expanding.
# - Case B asserts on a file, not on the transcript. Under TERM=dumb fish paints
#   the line only when it executes one, so a buffer that was wrapped and then
#   refused never reaches the transcript at all — "the output never contains
#   `| recite --as`" is true of the bug and of the fix alike. alt-z dumps the
#   real buffer instead.
#
# Sends are deliberately slow. Faster than fish's reader and it drops characters,
# which fails as a bug in the code rather than in the test.
#
# Every case ends with `expect eof`, a kill and a reap, because this file has to
# be runnable against the bug it catches. Broken code can leave an unparseable
# line in the buffer; `exit` then appends to that line instead of running, and a
# bare `wait` blocks forever on a shell that never exits. `expect eof` returns on
# its own timeout, so the kill is the thing that bounds the case. Without it,
# reintroducing a bug HANGS this suite instead of failing it, and a gate that
# hangs is worse than no gate: CI stalls rather than going red. `close` is the
# tidier-looking way to drop the pty and is wrong — it acts on the current spawn
# id, which after an eof can be the script's own stdout.
#
# ctrl-C clears a dirty buffer before `exit`, but belongs only in a case that
# asserts on a file the stub wrote: the INTR character FLUSHES the pty queues,
# discarding every byte expect has not read yet — and expect reads only during an
# `expect`, so that is all of them. Sent from case A for symmetry, it takes that
# case's whole transcript with it, and the case fails as though the binding had
# never fired.

set timeout 20
log_user 0

set here [file normalize [file dirname [info script]]]
set repo [file normalize "$here/.."]
set fish [exec sh -c "command -v fish"]

set fails 0

proc report {ok desc detail} {
    global fails
    if {$ok} {
        puts "ok   $desc"
    } else {
        puts "FAIL $desc"
        puts $detail
        incr fails
    }
}

# What comes back off a pty is a repaint, not a transcript: escape sequences for
# the cursor and \r for the line start. Strip them so an assertion compares text.
proc clean {s} {
    regsub -all {\x1b\][^\x07\x1b]*(\x07|\x1b\\)} $s "" s
    regsub -all {\x1b\[[0-9;?]*[a-zA-Z]} $s "" s
    regsub -all {\x1b[()][A-Za-z0-9]} $s "" s
    regsub -all {\x1b[=>]} $s "" s
    return [string map [list "\x00" "" "\r" "\n"] $s]
}

proc has_line {s want} {
    foreach line [split $s "\n"] {
        if {[string trim $line] eq $want} {
            return 1
        }
    }
    return 0
}

# The prompt comes from the generated rc, so seeing it proves the rc finished and
# the binding is installed. A blind sleep alone raced under load: keys that arrive
# first are read by a shell not yet holding the binding, and the case then fails
# as though the code were broken.
#
# The settle after it is not redundant. fish flushes pending input as it takes
# over the terminal, so a key sent between the prompt and that flush is discarded
# outright — the case then sees a line that was never typed.
proc wait_ready {} {
    expect "RDY> "
    sleep 1
}

proc slurp {path} {
    if {![file exists $path]} {
        return ""
    }
    set f [open $path r]
    set s [read $f]
    close $f
    return $s
}

# Stub clipboard plus the real core and the real shared executable on PATH, so
# nothing here can reach pbcopy. Same technique as test/fish-tests.fish.
#
# `recite` has to be here. Every shell layer is a shim onto it now, so a box
# holding only the two backends exercises the shim's no-backend branch instead of
# the pipeline — and every case below that asserts on the clipboard then fails
# with an empty file, reading as a binding bug.
set box [exec mktemp -d]
set f [open "$box/recite-clip" w]
puts $f "#!/bin/sh"
puts $f "cat > \"$box/copied\""
close $f
exec chmod 755 "$box/recite-clip"
exec cp "$repo/functions/recite-core" "$box/recite-core"
exec cp "$repo/functions/recite" "$box/recite"

set rc "$box/rc.fish"
set f [open $rc w]
puts $f "function fish_greeting; end"
puts $f "function fish_prompt; printf 'RDY> '; end"
puts $f "function fish_right_prompt; end"
puts $f "source $repo/functions/recite.fish"
puts $f "source $repo/functions/__recite_submit.fish"
puts $f "abbr -a zzq 'echo ABBR_EXPANDED'"
puts $f "bind alt-enter __recite_submit"
puts $f "function __recite_test_dump; commandline -b > $box/buffer; end"
puts $f "bind alt-z __recite_test_dump"
close $f

set env(PATH) "$box:/usr/bin:/bin"
set env(TERM) dumb
# zsh reads its rc out of ZDOTDIR, which is how the zsh cases below get a
# sandboxed config. Harmless to fish, which is told its config on the command
# line.
set env(ZDOTDIR) "$box"

# Case A: an abbreviation must expand, exactly as it does under plain enter.
# The needle is a whole line — the executed command line mentions ABBR_EXPANDED
# too, and only the command's own output proves the expansion actually ran.
spawn $fish --no-config -i -C "source $rc"
wait_ready
send "zzq"
sleep 0.6
send "\033\r"
sleep 2
send "exit\r"
expect eof
catch {exec kill -9 [exp_pid]}
catch wait
set a [clean $expect_out(buffer)]

report [expr {[has_line $a "ABBR_EXPANDED"]
              && [string first "Unknown command" $a] == -1}] \
    "an abbreviation expands under the binding" \
    "     transcript: \[$a\]"

# Case B: a half-typed construct must be left alone. Wrapped, it neither parses
# nor executes, and every further press wraps the wrapping.
set fragment "echo \"unterminated"
exec rm -f "$box/buffer" "$box/copied"
spawn $fish --no-config -i -C "source $rc"
wait_ready
send $fragment
sleep 0.6
send "\033\r"
sleep 2
send "\033z"
sleep 1
send "\003"
sleep 0.6
send "exit\r"
expect eof
catch {exec kill -9 [exp_pid]}
catch wait
set dumped [slurp "$box/buffer"]

# The existence check is load-bearing: without it a dump key that never fired
# reports ok, because a missing file contains no wrapper either.
report [expr {[file exists "$box/buffer"]
              && [string trim $dumped] eq $fragment}] \
    "an incomplete command line is not wrapped" \
    "     want buffer: \[$fragment\]\n     got buffer:  \[[string trim $dumped]\]"

# Case C: a trailing comment must not swallow the appended suffix. Concatenated,
# the `#` comments out `2>&1 | recite --as …`: the command runs bare, nothing is
# copied, and nothing says so.
#
# The needle is the clipboard file, never the transcript: the command runs and
# prints either way, so its output on screen is true of the bug and of the fix
# alike. A whole-line match keeps the `$ echo …` header from answering for the
# output it is supposed to introduce.
exec rm -f "$box/buffer" "$box/copied"
spawn $fish --no-config -i -C "source $rc"
wait_ready
send "echo RECITE_COMMENT_CASE # note"
sleep 0.6
send "\033\r"
sleep 2
send "\003"
sleep 0.6
send "exit\r"
expect eof
catch {exec kill -9 [exp_pid]}
catch wait
set copied [slurp "$box/copied"]

report [has_line $copied "RECITE_COMMENT_CASE"] \
    "a trailing comment does not swallow the suffix" \
    "     clipboard: \[$copied\]"

# Case D: a trailing semicolon. Concatenated, `… ; 2>&1 | recite` is a parse
# error and the command never runs at all.
#
# The obvious assertion — that the session does not print "Expected a string" —
# is worthless twice over. Under TERM=dumb fish paints nothing for a line it
# refuses to execute, so that error never reaches the transcript against the bug
# either; and the ctrl-C below flushes the transcript regardless. The clipboard is
# the only witness that the command ran at all.
exec rm -f "$box/buffer" "$box/copied"
spawn $fish --no-config -i -C "source $rc"
wait_ready
send "echo RECITE_SEMI_CASE;"
sleep 0.6
send "\033\r"
sleep 2
send "\003"
sleep 0.6
send "exit\r"
expect eof
catch {exec kill -9 [exp_pid]}
catch wait
set copied [slurp "$box/copied"]

report [has_line $copied "RECITE_SEMI_CASE"] \
    "a trailing semicolon still parses and runs" \
    "     clipboard: \[$copied\]"

# Case E: a trailing ampersand, the same parse error from the other direction.
# Inside the block it backgrounds a statement instead of colliding with the
# redirection an appended suffix puts after it.
exec rm -f "$box/buffer" "$box/copied"
spawn $fish --no-config -i -C "source $rc"
wait_ready
send "echo RECITE_AMP_CASE &"
sleep 0.6
send "\033\r"
sleep 2
send "\003"
sleep 0.6
send "exit\r"
expect eof
catch {exec kill -9 [exp_pid]}
catch wait
set copied [slurp "$box/copied"]

report [has_line $copied "RECITE_AMP_CASE"] \
    "a trailing ampersand still parses and runs" \
    "     clipboard: \[$copied\]"

# ---------------------------------------------------------------- zsh ----
#
# zsh has no autoload for a ZLE widget, so its layer arrives by
# `eval "$(recite init zsh)"` rather than by being on a function path. That is
# what these spawn: the same two lines the README tells a zsh user to paste.
#
# Two cases, not five. The trailing-comment, semicolon and ampersand cases live
# in test/zsh-tests.zsh, which runs the rewritten buffer directly and needs no
# pty for it. What only a pty can answer is whether the KEYSTROKE reaches the
# widget at all, and what the line editor is left holding when it declines.
#
# No abbreviation case: zsh has no built-in abbreviation to expand, so there is
# nothing for the widget to be accused of skipping.
set zsh ""
catch {set zsh [exec sh -c "command -v zsh"]}

# Three-way, and the middle branch is the one worth having. An uncaught error out
# of `recite init zsh` exits expect before a single zsh case runs, and what the
# reader sees is a suite that printed five green fish lines and stopped — which
# looks like a pass with a short tail rather than a gate that never ran.
set zsh_ready 0
if {$zsh eq ""} {
    puts "skip (zsh not installed)"
} elseif {[catch {exec $box/recite init zsh > $box/init.zsh} err]} {
    report 0 "zsh: recite init zsh emits a layer" "     $err"
} else {
    set zsh_ready 1
}

if {$zsh_ready} {
    set f [open "$box/.zshrc" w]
    puts $f "PROMPT='RDY> '"
    puts $f "RPROMPT=''"
    puts $f "source $box/init.zsh"
    # Braced, so Tcl substitutes nothing inside: `^[` is caret notation for
    # escape, and a bare `[` opens a command substitution in a Tcl double-quoted
    # string. These two are verbatim the lines the README gives a zsh user.
    puts $f {bindkey '^[^M' __recite_submit}
    puts $f "__recite_test_dump() \{ print -r -- \"\$BUFFER\" > $box/buffer \}"
    puts $f "zle -N __recite_test_dump"
    puts $f {bindkey '^[z' __recite_test_dump}
    close $f

    # ZDOTDIR + -d, NOT -f: `-f` skips the sandbox rc along with the system ones,
    # so the layer never loads and both cases fail as though the widget were
    # broken.
    #
    # Case Z1: the keystroke reaches the widget and the whole pipeline runs. The
    # needle is the clipboard file rather than the transcript, for the reason
    # case C records — the command prints either way.
    #
    # `expect` on recite's own "copied", never a blind sleep, and never a ctrl-C.
    # Measured, and it is the pty rather than the code: expect reads the master
    # side only while an `expect` is running, so during a `sleep` the pty output
    # queue fills and the recited pipeline BLOCKS inside its tee. A ctrl-C in that
    # window is the worst possible thing to send — INTR flushes the terminal
    # queues, the blocked write completes with the output discarded, and the core
    # formats a block with an empty body. That copies, and reads exactly like the
    # tee having been skipped. Waiting for the sink to speak drains the pty and
    # proves the run finished, both of which a sleep only hopes for.
    exec rm -f "$box/buffer" "$box/copied"
    spawn $zsh -di
    wait_ready
    send "echo RECITE_ZSH_CASE"
    sleep 0.6
    send "\033\r"
    expect "recite: copied"
    sleep 0.5
    send "exit\r"
    expect eof
    catch {exec kill -9 [exp_pid]}
    catch wait
    set copied [slurp "$box/copied"]

    report [has_line $copied "RECITE_ZSH_CASE"] \
        "zsh: the binding copies through the shared executable" \
        "     clipboard: \[$copied\]"

    # Case Z2: a half-typed construct is left alone, the same claim case B makes
    # for fish. Only a pty can make it: what is under test is the buffer the line
    # editor is holding after the keystroke, and the assertion is on the file the
    # dump key wrote, never on the transcript — under TERM=dumb a line that is
    # never executed is never painted.
    set fragment "echo \"unterminated"
    exec rm -f "$box/buffer" "$box/copied"
    spawn $zsh -di
    wait_ready
    send $fragment
    sleep 0.6
    send "\033\r"
    sleep 2
    send "\033z"
    sleep 1
    send "\003"
    sleep 0.6
    send "exit\r"
    expect eof
    catch {exec kill -9 [exp_pid]}
    catch wait
    set dumped [slurp "$box/buffer"]

    # The existence check is load-bearing: without it a dump key that never fired
    # reports ok, because a missing file contains no wrapper either.
    report [expr {[file exists "$box/buffer"]
                  && [string trim $dumped] eq $fragment}] \
        "zsh: an incomplete command line is not wrapped" \
        "     want buffer: \[$fragment\]\n     got buffer:  \[[string trim $dumped]\]"
}

exec rm -rf $box
exit $fails
