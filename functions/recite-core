#!/bin/sh
# recite-core — format captured command output as a pasteable console block.
#
# Raw output on stdin, formatted block on stdout. Copying is recite-clip's job,
# so this stays a pure filter and is golden-testable without a clipboard.
#
# Usage: recite-core [--as <command string>] [--no-redact] [--version]
#
# Environment:
#   RECITE_MAX_LINES  max output lines to keep   (default 1000)
#   RECITE_MAX_BYTES  max output bytes to keep   (default 102400)
#
# Exit: 0 ok · 2 usage/internal · 3 input refused (binary)
set -u

# The one version string in the project: `recite --version` shells out to this
# rather than carrying its own, so a half-upgraded install reports one version
# rather than two that agree.
version=0.2.0

as=
redact=1
max_lines=${RECITE_MAX_LINES:-1000}
max_bytes=${RECITE_MAX_BYTES:-102400}

while [ $# -gt 0 ]; do
  case $1 in
    --as)
      [ $# -ge 2 ] || { echo "recite-core: --as needs a value" >&2; exit 2; }
      as=$2
      shift 2
      ;;
    --no-redact)
      redact=
      shift
      ;;
    --version)
      echo "recite-core $version"
      exit 0
      ;;
    *)
      # Warned, never fatal: the channels version independently, so a newer
      # recite.fish handing this core an unknown flag must degrade rather than
      # die. Said out loud because silence lets `--version` be swallowed here
      # while the core blocks reading stdin. stderr never reaches the clipboard,
      # so the warning is free.
      echo "recite-core: ignored unrecognized argument: $1" >&2
      shift
      ;;
  esac
done

# Buffer stdin: needed twice (binary sniff, then formatting) and not seekable.
# The explicit template is for BSD mktemp, which has not always accepted a bare
# `mktemp`.
tmp=$(mktemp "${TMPDIR:-/tmp}/recite.XXXXXX") || exit 2
trap 'rm -f "$tmp"' EXIT INT TERM
cat > "$tmp"

# Refuse binary rather than mangle it: shell variables cannot hold NUL and awk's
# behaviour on it is undefined, so the alternative is silent corruption.
# If deleting NULs changes the file, the file had NULs.
if ! LC_ALL=C tr -d '\000' < "$tmp" | cmp -s - "$tmp"; then
  echo "recite-core: input contains NUL bytes (binary?); refusing" >&2
  exit 3
fi

# One awk pass: CR normalization, ANSI stripping, redaction, cap. Three traps
# live in this invocation.
#
# The `$ <command>` header is emitted from BEGIN so it goes through the SAME
# scrub() as the body. Printf'd above this block instead, the one line the user
# did not choose — `commandline -b` verbatim from the binding — becomes the only
# part reaching the clipboard unredacted.
#
# The command arrives via the environment, not -v: awk processes escape sequences
# in a -v value, so a command containing \t or \n would be silently rewritten on
# its way to the clipboard.
#
# LC_ALL=C makes length() count bytes (so RECITE_MAX_BYTES means what it says)
# and matching deterministic, which is what the byte-identity goldens rest on.
# UTF-8 still passes through as bytes.
RECITE_AS="$as" LC_ALL=C awk \
  -v redact="$redact" \
  -v maxl="$max_lines" \
  -v maxb="$max_bytes" '
# No apostrophe anywhere below, comments included: this whole program is one sh
# single-quoted string, and one closes it mid-awk. The shell then reads the rest
# of the awk source as commands, so the error blames a shell syntax error on a
# line inside this quote and never mentions awk.

# Replace every boundary-anchored match of `re` in `s`. `re` is a STRING, not a
# /…/ constant: a regex constant passed as an argument evaluates to `$0 ~ /…/`,
# i.e. 0 or 1, and match() would then hunt for the literal "0" — a redactor that
# quietly does nothing.
#
# gsub cannot express this. Anchoring needs the character BEFORE the match, and
# POSIX awk has neither \b nor a backreference to put it back, so the line is
# walked and rebuilt. Interval-free and backreference-free, so BWK, gawk and
# mawk agree — which is what cross-platform byte-identity will rest on.
#
# Unanchored, `sk-` matched inside task-force, disk-usage and feature/task-1234,
# and the corruption was invisible: the terminal showed the truth and only the
# clipboard was wrong.
function redact_re(s, re,   out, rest, pre, hit, prev) {
  out = ""; rest = s; prev = ""
  while (match(rest, re)) {
    pre = substr(rest, 1, RSTART - 1)
    hit = substr(rest, RSTART, RLENGTH)
    if (RSTART > 1) prev = substr(rest, RSTART - 1, 1)
    out = out pre ((prev == "" || prev !~ /[A-Za-z0-9_-]/) ? "[REDACTED]" : hit)
    prev = substr(hit, length(hit), 1)
    rest = substr(rest, RSTART + RLENGTH)
  }
  return out rest
}

# Replace the password in a URL, keeping scheme, user and host — the host is
# the informative half of the line, and [REDACTED] in its place tells a reader
# nothing. ERE has no lookbehind, so the surroundings have to be rebuilt by hand.
function redact_userinfo(s,   out, rest, pre, hit) {
  out = ""; rest = s
  while (match(rest, /:\/\/[^\/@[:space:]]+@/)) {
    pre = substr(rest, 1, RSTART - 1)
    hit = substr(rest, RSTART, RLENGTH)
    # Only when it actually carries a password. A bare user@host is not a
    # credential, and redacting it would corrupt ordinary git and ssh output.
    if (hit ~ /:\/\/[^\/@:[:space:]]+:[^\/@[:space:]]+@/) {
      sub(/:[^\/@[:space:]]+@$/, ":[REDACTED]@", hit)
    }
    out = out pre hit
    rest = substr(rest, RSTART + RLENGTH)
  }
  return out rest
}

function scrub(s) {
  # Keep only what the terminal would have shown: text after the last CR.
  # .* is greedy, so this anchors on the LAST carriage return, not the first.
  sub(/.*\r/, "", s)

  # CSI: parameter bytes, then intermediate bytes, then a final byte. The final
  # class is the full @-~, not [a-zA-Z]: colours are m, cursor moves and erases
  # are A-K, and \033[?25l / \033[?25h (hide/show cursor) is what every spinner
  # emits — cargo, npm, docker, pip. The parameter class carries the colon
  # because \033[38:2:R:G:B m is the colon spelling of truecolor; without it the
  # whole sequence survives into the paste while the semicolon spelling is
  # stripped. The intermediate class is what makes \033[?1$p (and anything else
  # carrying a byte in the space-to-slash range) match at all.
  gsub(/\033\[[0-9;:<=>?]*[ -\/]*[@-~]/, "", s)

  # OSC, terminated by BEL **or** ST (\033\\). ST is what OSC 8 hyperlinks use,
  # and without it the raw bytes reach the clipboard.
  #
  # Excluding \033 from the body is load-bearing, not tidiness: with a bare
  # [^\007]* an ST-terminated sequence does not end at its own terminator, so it
  # runs on to the next BEL anywhere later in the line and DELETES the ordinary
  # text in between: A<osc8>B<title>C becomes AC.
  gsub(/\033\][^\033\007]*(\007|\033\\)/, "", s)

  # nF escapes — charset designation such as \033(B, which pagers and TUIs emit
  # on the way out.
  gsub(/\033[ -\/]+[0-~]/, "", s)

  # Remaining single-character Fe escapes. Must come LAST: it would otherwise
  # eat the \033] of an OSC introducer and leave the body as text.
  gsub(/\033[@-Z\\-_]/, "", s)

  if (redact) {
    # Every pattern is a STRING (see redact_re) and every one is anchored at a
    # token boundary, which real credentials always sit on.
    s = redact_re(s, "sk-[A-Za-z0-9_-]+")
    s = redact_re(s, "gh[pousr]_[A-Za-z0-9]+")
    # Not foldable into gh[pousr]_: the character after "gh" in a fine-grained
    # PAT is "i", which that class cannot match.
    s = redact_re(s, "github_pat_[A-Za-z0-9_]+")
    # Slack, whole prefix family at once. Slack IS the documented paste target,
    # so a live xoxb- bot token is the worst case in the set.
    s = redact_re(s, "xox[a-z]-[A-Za-z0-9-]+")
    s = redact_re(s, "xapp-[A-Za-z0-9-]+")
    s = redact_re(s, "(AKIA|ASIA)[0-9A-Z]+")
    # \\. not \. — awk processes escapes in a string literal.
    s = redact_re(s, "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+")
    # Stripe. `sk_` with an UNDERSCORE, which the OpenAI `sk-` pattern above
    # cannot match — a one-character difference between two near-identical
    # prefixes, and the kind of gap a user assumes is covered. The live|test
    # segment is required: a bare [sr]k_ would match ordinary identifiers. `rk_`
    # is the restricted-key form; the publishable `pk_` is not a secret.
    s = redact_re(s, "[sr]k_(live|test)_[A-Za-z0-9]+")
    s = redact_re(s, "AIza[0-9A-Za-z_-]+")
    s = redact_re(s, "glpat-[A-Za-z0-9_-]+")
    s = redact_re(s, "npm_[A-Za-z0-9]+")
    # A webhook URL is a bearer credential: whoever holds it can post into the
    # channel. Slack is the documented paste target, so this belongs with the
    # xox- tokens above. \\. again, for the reason two patterns up.
    s = redact_re(s, "hooks\\.slack\\.com/services/[A-Za-z0-9/_-]+")
    # After the prefix patterns: a token inside a URL is redacted by them first,
    # and this then finds whatever had no recognisable prefix.
    s = redact_userinfo(s)
  }
  return s
}

# The fence has to be longer than any backtick run inside it, or the block ends
# where the content has a fence of its own and the rest of the paste falls out
# of the code block. CommonMark allows any length >= 3; the closing fence must
# be at least as long as the opening one, so both are sized from the same number.
function longest_backtick_run(s,   n, best, i, c) {
  best = 0; n = 0
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "`") { n++; if (n > best) best = n } else { n = 0 }
  }
  return best
}

# Only ever called on text that will actually be PRINTED. A line dropped by the
# cap cannot break the fence, and scanning every line instead of every kept one
# is measurably slower on large inputs.
function note_run(s,   r) { r = longest_backtick_run(s); if (r > maxrun) maxrun = r }
BEGIN {
  # Never counted against the cap: truncating the one line that makes sense of
  # the rest would leave an orphan block.
  #
  # Buffered rather than printed: the fence that must precede it is sized from
  # content this line is part of, so nothing can be emitted until END.
  as = ENVIRON["RECITE_AS"]
  if (as != "") { header = "$ " scrub(as); note_run(header) }
}
{
  $0 = scrub($0)

  # PEM private-key blocks: the secret is the BODY, undifferentiated base64 that
  # no per-line pattern can match without also eating ordinary text. Only state
  # across lines can see it, which is why this is not in scrub().
  #
  # Line-for-line rather than collapsed to one marker: the cap counts lines and
  # the truncation trailer reports them, so replacing N lines with 1 would make
  # "[Output truncated: N lines omitted]" wrong.
  if (redact) {
    if ($0 ~ /-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/)     in_pem = 1
    else if ($0 ~ /-----END [A-Z0-9 ]*PRIVATE KEY-----/)  in_pem = 0
    else if (in_pem)                                      $0 = "[REDACTED]"
  }

  total++
  # Once a line does not fit, no later line is kept either. Judging each line on
  # its own would skip one long line and resume with shorter ones, cutting text
  # out of the MIDDLE while the trailer still called it "omitted" — a transcript
  # that reads as contiguous and never happened.
  if (!stopped && kept < maxl && bytes + length($0) + 1 <= maxb) {
    keep[++kept] = $0
    note_run($0)
    bytes += length($0) + 1
  } else {
    stopped = 1
  }
}
END {
  n = maxrun + 1
  if (n < 3) n = 3
  fence = ""
  for (i = 0; i < n; i++) fence = fence "`"

  printf "%sconsole\n", fence
  if (header != "") print header
  for (i = 1; i <= kept; i++) print keep[i]
  if (total > kept) {
    printf "[Output truncated: %d lines omitted]\n", total - kept
  }
  printf "%s\n", fence
}
' < "$tmp"
